\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Mit der aus der CO$_2$-Bande bestimmten Schrittweite kalibriertes FFT-Spektrum (blau) im Vergleich mit dem Referenzspektrum aus Aufgabe~1.1 (orange); die gepunktete Linie markiert die CO$_2$-Bande bei $\SI {2349}{cm^{-1}}$. Die vollständige Übereinstimmung sämtlicher Wasserdampf-Rotationslinien und der CO$_2$-Bande in beiden Spektren bestätigt die ermittelte Schrittweite; die scharfen Wasserdampf-Peaks dienen dabei als Kalibriermarken.}}{17}{figure.caption.16}\protected@file@percent }
\newlabel{fig:a2_kalibrierung}{{11}{17}{Mit der aus der CO$_2$-Bande bestimmten Schrittweite kalibriertes FFT-Spektrum (blau) im Vergleich mit dem Referenzspektrum aus Aufgabe~1.1 (orange); die gepunktete Linie markiert die CO$_2$-Bande bei $\SI {2349}{cm^{-1}}$. Die vollständige Übereinstimmung sämtlicher Wasserdampf-Rotationslinien und der CO$_2$-Bande in beiden Spektren bestätigt die ermittelte Schrittweite; die scharfen Wasserdampf-Peaks dienen dabei als Kalibriermarken}{figure.caption.16}{}}
