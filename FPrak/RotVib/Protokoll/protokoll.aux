\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Auf den Wasserdampf-Hintergrund normiertes Transmissionsspektrum der Polystyrolfolie (links) und Einkanalspektrum des Wasserdampfs (rechts). Die roten gepunkteten Linien markieren die zur Kalibrierung verwendeten theoretischen Wellenzahlen der Absorptionsbanden.}}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:eich_spektren}{{5}{11}{Auf den Wasserdampf-Hintergrund normiertes Transmissionsspektrum der Polystyrolfolie (links) und Einkanalspektrum des Wasserdampfs (rechts). Die roten gepunkteten Linien markieren die zur Kalibrierung verwendeten theoretischen Wellenzahlen der Absorptionsbanden}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Vergrößerte Ausschnitte des normierten Polystyrolspektrums. Die grünen gestrichelten Linien markieren die theoretischen Referenzwellenzahlen, die roten Punkte die zugehörigen gemessenen Bandenminima. Durch die Normierung auf den Hintergrund treten die Banden als klare Transmissionseinbrüche hervor; die vereinzelten schmalen Spikes im mittleren Fenster sind Artefakte der Division in Bereichen, in denen der Wasserdampf nahezu vollständig absorbiert ($I_0 \approx 0$).}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:eich_zoom_poly}{{6}{12}{Vergrößerte Ausschnitte des normierten Polystyrolspektrums. Die grünen gestrichelten Linien markieren die theoretischen Referenzwellenzahlen, die roten Punkte die zugehörigen gemessenen Bandenminima. Durch die Normierung auf den Hintergrund treten die Banden als klare Transmissionseinbrüche hervor; die vereinzelten schmalen Spikes im mittleren Fenster sind Artefakte der Division in Bereichen, in denen der Wasserdampf nahezu vollständig absorbiert ($I_0 \approx 0$)}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Vergrößerte Ausschnitte des Wasserdampfspektrums. Grüne gestrichelte Linien: theoretische Referenzwellenzahlen; rote Punkte: gemessene Bandenminima. Im Fenster um $\SI {1800}{cm^{-1}}$ ist erkennbar, dass die vier dicht benachbarten Referenzlinien bei der vorliegenden Auflösung nicht alle eindeutig getrennt werden können; markiert sind nur die verlässlich zuordenbaren Banden.}}{13}{figure.caption.10}\protected@file@percent }
\newlabel{fig:eich_zoom_water}{{7}{13}{Vergrößerte Ausschnitte des Wasserdampfspektrums. Grüne gestrichelte Linien: theoretische Referenzwellenzahlen; rote Punkte: gemessene Bandenminima. Im Fenster um $\SI {1800}{cm^{-1}}$ ist erkennbar, dass die vier dicht benachbarten Referenzlinien bei der vorliegenden Auflösung nicht alle eindeutig getrennt werden können; markiert sind nur die verlässlich zuordenbaren Banden}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Relative Abweichung der gemessenen von den theoretischen Bandenwellenzahlen für Polystyrol (links) und Wasserdampf (rechts), aufgetragen über die theoretische Wellenzahl. Die durchgezogene Linie kennzeichnet die Nullabweichung, die gestrichelte den jeweiligen Mittelwert. Die Punkte liegen überwiegend oberhalb der Nulllinie, was den systematischen Skalenfehler ($a>1$) widerspiegelt.}}{14}{figure.caption.11}\protected@file@percent }
\newlabel{fig:eich_abweichung}{{8}{14}{Relative Abweichung der gemessenen von den theoretischen Bandenwellenzahlen für Polystyrol (links) und Wasserdampf (rechts), aufgetragen über die theoretische Wellenzahl. Die durchgezogene Linie kennzeichnet die Nullabweichung, die gestrichelte den jeweiligen Mittelwert. Die Punkte liegen überwiegend oberhalb der Nulllinie, was den systematischen Skalenfehler ($a>1$) widerspiegelt}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Eichung der Wellenzahlskala: gemessene über theoretische Bandenwellenzahl für Polystyrol (Kreise) und Wasserdampf (Quadrate). Die rote Linie ist die lineare Regression $\bar  \nu _\mathrm  {mess}=a\,\bar  \nu _\mathrm  {theo} +b$, die graue gestrichelte Linie die Ideal-Gerade. Beide sind auf dieser Skala nahezu deckungsgleich.}}{15}{figure.caption.12}\protected@file@percent }
\newlabel{fig:eich_regression}{{9}{15}{Eichung der Wellenzahlskala: gemessene über theoretische Bandenwellenzahl für Polystyrol (Kreise) und Wasserdampf (Quadrate). Die rote Linie ist die lineare Regression $\bar \nu _\mathrm {mess}=a\,\bar \nu _\mathrm {theo} +b$, die graue gestrichelte Linie die Ideal-Gerade. Beide sind auf dieser Skala nahezu deckungsgleich}{figure.caption.12}{}}
